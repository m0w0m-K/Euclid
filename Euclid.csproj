<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <OutputType>Library</OutputType>
    <AssemblyName>Euclid</AssemblyName>
    <Version>1.0.1</Version>
    <RootNamespace>Euclid</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == '' and '$(ADOFAI_DIR)' != ''">$(ADOFAI_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\A Dance of Fire and Ice</GameDir>
    <ManagedAssembliesDir>$(GameDir)\A Dance of Fire and Ice_Data\Managed</ManagedAssembliesDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(ManagedAssembliesDir)\UnityModManager\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedAssembliesDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RDTools">
      <HintPath>$(ManagedAssembliesDir)\RDTools.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedAssembliesDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedAssembliesDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedAssembliesDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ManagedAssembliesDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedAssembliesDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextCoreFontEngineModule">
      <HintPath>$(ManagedAssembliesDir)\UnityEngine.TextCoreFontEngineModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextCoreTextEngineModule">
      <HintPath>$(ManagedAssembliesDir)\UnityEngine.TextCoreTextEngineModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedAssembliesDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedAssembliesDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedAssembliesDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="netstandard">
      <HintPath>$(ManagedAssembliesDir)\netstandard.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityModManager">
      <HintPath>$(ManagedAssembliesDir)\UnityModManager\UnityModManager.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Localization\*.lang">
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="ValidateGameReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error
      Condition="'%(Reference.HintPath)' != '' and !Exists('%(Reference.HintPath)')"
      Text="Required game/UMM DLL is missing: %(Reference.HintPath). Set GameDir, ADOFAI_DIR, or Directory.Build.props to the ADOFAI installation." />
  </Target>

  <Target Name="DeployDebugMod" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Debug' and '$(OS)' == 'Windows_NT' and '$(SkipDebugDeploy)' != 'true'">
    <PropertyGroup>
      <DebugModDirectory Condition="'$(DebugModDirectory)' == ''">$(GameDir)\Mods\Euclid</DebugModDirectory>
    </PropertyGroup>
    <MakeDir Directories="$(DebugModDirectory)" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFiles="$(DebugModDirectory)\Euclid.dll"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Info.json"
          DestinationFiles="$(DebugModDirectory)\Info.json"
          SkipUnchangedFiles="true" />
    <Message Text="Debug mod deployed to $(DebugModDirectory)" Importance="high" />
  </Target>

  <Target Name="CreateUmmRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' and '$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <UmmReleaseRoot>$(MSBuildProjectDirectory)\dist</UmmReleaseRoot>
      <UmmReleaseDir>$(UmmReleaseRoot)\Euclid</UmmReleaseDir>
      <UmmReleaseZip>$(UmmReleaseRoot)\Euclid-$(Version).zip</UmmReleaseZip>
    </PropertyGroup>
    <RemoveDir Directories="$(UmmReleaseDir)" Condition="Exists('$(UmmReleaseDir)')" />
    <MakeDir Directories="$(UmmReleaseDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(UmmReleaseDir)\Euclid.dll" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Info.json" DestinationFiles="$(UmmReleaseDir)\Info.json" />
    <!-- Keep Info.json at the ZIP root. UMM's in-place update path assumes a root-level ModInfo file;
         packaging the Euclid directory itself can send UMM through its nested-folder rewrite path,
         which is fragile for root entries and can throw Substring(startIndex = -1). -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;if (Test-Path -LiteralPath '$(UmmReleaseZip)') { Remove-Item -LiteralPath '$(UmmReleaseZip)' -Force }; Compress-Archive -Path '$(UmmReleaseDir)\*' -DestinationPath '$(UmmReleaseZip)' -CompressionLevel Optimal&quot;" />
    <Message Text="UMM release created: $(UmmReleaseZip)" Importance="high" />
  </Target>

</Project>
